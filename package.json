{
  "name": "isoloir",
  "private": true,
  "version": "0.1.0",
  "description": "Isoloir : boussole électorale 100 % locale. Vos réponses ne quittent jamais votre appareil.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node tools/check-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "e2e": "node tools/e2e-offline.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "playwright-core": "1.62.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
